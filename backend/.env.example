# ==============================================================================
# CPRMP Backend Environment Configuration Template
# Copy this file to '.env' inside the 'backend/' directory before starting:
#   Windows PowerShell: Copy-Item .env.example .env
#   macOS / Linux:     cp .env.example .env
# ==============================================================================

# Node runtime environment (development, test, production)
NODE_ENV=development

# Port where Express HTTP server listens (default: 5000)
# Note: Vite frontend proxies /api calls to http://localhost:5000 by default
PORT=5000

# Allowed client origin for CORS in development/production
CLIENT_URL=http://localhost:5173

# MongoDB Connection String:
# Local Community Server: mongodb://127.0.0.1:27017/cprmp
# MongoDB Atlas (Cloud): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cprmp?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/cprmp

# Secret key used to sign and verify JWT authentication tokens (HS256)
# MUST be changed to a long, secure random string in production
JWT_SECRET=cprmp_development_jwt_secret_key_2026_super_secure

# Token lifespan before expiry (e.g., 1d, 7d, 24h)
JWT_EXPIRES_IN=1d

# Maximum allowed file size for resume uploads in megabytes (default: 5)
MAX_RESUME_SIZE_MB=5